rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isSuperAdmin(){return signedIn() && request.auth.token.email == 'zeohm_pply@777.com';}
  function isAdmin(){return isSuperAdmin() || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true);}
  function hasDriverProfile(){return signedIn() && exists(/databases/$(database)/documents/driverProfiles/$(request.auth.uid));}
  function approvedDriverFor(busId){return hasDriverProfile() && get(/databases/$(database)/documents/driverProfiles/$(request.auth.uid)).data.status == 'approved' && get(/databases/$(database)/documents/driverProfiles/$(request.auth.uid)).data.busId == busId;}
  match /admins/{uid} {
   allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
   allow list: if isSuperAdmin();
   allow create: if signedIn() && request.auth.uid == uid && request.resource.data.email == request.auth.token.email
    && request.resource.data.active == true && request.resource.data.source == 'invitation'
    && exists(/databases/$(database)/documents/adminInvites/$(request.auth.token.email))
    && get(/databases/$(database)/documents/adminInvites/$(request.auth.token.email)).data.status == 'accepted'
    && get(/databases/$(database)/documents/adminInvites/$(request.auth.token.email)).data.uid == request.auth.uid;
   allow update,delete: if isSuperAdmin();
  }
  match /subscriptionPackages/{packageId} {
   allow read: if isAdmin();
   allow create,update,delete: if isSuperAdmin();
  }
  match /adminInvites/{email} {
   allow create,delete: if isAdmin();
   allow get: if isAdmin() || (signedIn() && request.auth.token.email == email);
   allow list: if isAdmin();
   allow update: if (isAdmin() && request.resource.data.email == email && request.resource.data.status == 'pending')
    || (signedIn() && request.auth.token.email == email && resource.data.status == 'pending'
    && request.resource.data.status == 'accepted' && request.resource.data.uid == request.auth.uid
    && request.time < resource.data.expiresAt
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','uid','acceptedAt']));
  }
  match /driverProfiles/{uid} {
   allow create: if signedIn() && request.auth.uid == uid && request.resource.data.email == request.auth.token.email
    && request.resource.data.status == 'pending'
    && exists(/databases/$(database)/documents/buses/$(request.resource.data.busId))
    && get(/databases/$(database)/documents/buses/$(request.resource.data.busId)).data.active == true
    && get(/databases/$(database)/documents/buses/$(request.resource.data.busId)).data.busNumber == request.resource.data.busNumber;
   allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
   allow list: if isAdmin();
   allow update,delete: if isAdmin();
  }
  match /buses/{busId} {
   allow get: if isAdmin() || approvedDriverFor(busId);
   allow list: if signedIn();
   allow create,update,delete: if isAdmin();
   match /routes/{routeId} { allow read,create,update,delete: if approvedDriverFor(busId) || isAdmin(); }
   match /locationEvents/{eventId} {
    allow create: if approvedDriverFor(busId) && request.resource.data.driverId == request.auth.uid && request.resource.data.busId == busId;
    allow read: if isAdmin();
   }
   match /locationStatus/{statusId} {
    allow create,update: if approvedDriverFor(busId) && request.resource.data.driverId == request.auth.uid && request.resource.data.busId == busId;
    allow get: if isAdmin();
   }
  }
  match /driverPerformance/{uid}/records/{recordId} {
   allow read,create,update,delete: if signedIn() && (request.auth.uid == uid || isAdmin());
  }
 }
}
